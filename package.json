{
  "name": "towfiq_portfolio",
  "private": true,
  "type": "module",
  "version": "2.0",
  "scripts": {
    "start": "vite",
    "prebuild": "npm run sync:local",
    "build": "tsc && vite build",
    "sync": "npx tsx --env-file=.env scripts/scrape-website-context.js",
    "sync:local": "npx tsx scripts/generate-website-context.js && npx tsx scripts/generate-knowledge-doc.js",
    "rag:ingest": "npm run sync:local && node --env-file-if-exists=.env --import tsx scripts/ingest-rag.js"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "chatling": "^0.3.0",
    "classnames": "^2.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "prettier": {
    "printWidth": 120,
    "endOfLine": "auto"
  },
  "homepage": "https://towfiq-ul.github.io"
}
