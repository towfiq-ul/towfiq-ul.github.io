# Copy to .dev.vars for local `wrangler dev` testing. Never commit .dev.vars.
# In production these are set via `wrangler secret put`, not this file.

AI_API_KEY=your_openrouter_api_key
# Gemini (OpenAI-compatible endpoint). For OpenRouter use https://openrouter.ai/api/v1
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Comma-separated: primary first, then fallbacks tried on 404/429/5xx.
AI_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash
# Optional: minimal | low | medium | high (not sent to OpenRouter).
AI_REASONING_EFFORT=minimal