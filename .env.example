# EmailJS Configuration
# Get these values from https://www.emailjs.com/

# Your EmailJS Public Key (from Account > API Keys)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Your EmailJS Service ID (from Email Services)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# Your EmailJS Template ID (from Email Templates)
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# Email address where you want to receive contact form submissions
VITE_RECEIVER_EMAIL=your_receiver_email_here

# URL of the AI assistant Worker (workers/ai-proxy.js). Model settings live in the Worker.
VITE_AI_PROXY_URL=''

# Legacy `npm run sync` only (scrapes the live site); not needed for build or CI.
VITE_AI_CONTEXT_DATA_URL=''
VITE_SCRAPPER_DOMAIN=''
VITE_SCRAPPER_TOKEN=''

# RAG index (npm run rag:ingest). URL defaults to VITE_AI_PROXY_URL; the token must
# match the Worker secret set with `npx wrangler secret put INGEST_TOKEN`.
RAG_INGEST_URL=
RAG_INGEST_TOKEN=
